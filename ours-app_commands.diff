+            rss_kb,
+            vsz_kb,
+            text,
+        })
+    else
+        alloc.print("pid={d} rss_kb={d} vsz_kb={d}\n", .{
+            io_mod.currentProcessId(),
+            rss_kb,
+            vsz_kb,
+        });
