+/// Deletes a configured connection, its saved model, and its stored key. The
+/// built-in providers are refused: `gateway`, `codex`, and `grok` are not
+/// connections the profile defines, so there is nothing to delete.
+fn removeConfiguredProviderCommand(
+    alloc: Allocator,
+    cfg: Config,
+    deps: RunDeps,
+    name: []const u8,
+) !RunResult {
+    _ = cfg;
+    if (name.len == 0 or name.len > 64) {
+        try writeStderr(deps, "fx provider remove: expected a configured provider name\n");
+        return usage_failure;
+    }
+    if (provider_catalog.parse(name) != null) {
+        try writeStderr(deps, "fx provider remove: the built-in providers cannot be removed\n");
+        return usage_failure;
+    }
+    var attempt = config_runtime.attemptUserPreferences(alloc, .{ .remove_provider = name });
+    defer attempt.deinit(alloc);
+    switch (attempt) {
+        .failure => {
+            try writeStderr(deps, "fx provider remove: the settings could not be saved\n");
+            return .handled_failure;
+        },
+        .outcome => |outcome| {
+            if (outcome == .unchanged) {
+                const message = try alloc.print("fx provider remove: no configured provider named {s}\n", .{name});
+                defer alloc.free(message);
+                try writeStderr(deps, message);
+                return .handled_failure;
+            }
+        },
+    }
+    const message = try alloc.print("Removed provider {s}.\n", .{name});
+    defer alloc.free(message);
+    try writeStdout(deps, message);
+    return .handled_success;
+}
+
+/// The first model a configured provider offers, or null when its catalog
+/// cannot be read. Used when a provider is selected before any model of its own
+/// was saved, so switching to a freshly added provider works instead of asking
+/// the user to run a second command.
+fn resolveFirstCatalogModel(
+    alloc: Allocator,
+    cfg: Config,
+    settings: config_runtime.Settings,
+    bound: model_provider.ProviderId,
+) !?[]u8 {
+    const definition = settings.providers orelse return null;
+    const entry = definition.get(bound.label()) orelse return null;
+    const provider = chat_completions.model_catalog_provider(entry);
+    const access: credentials.CatalogAccess = blk: {
+        if (cfg.auth_mode == .host_managed) break :blk .host_managed;
+        const token: ?[]const u8 = switch (entry.auth) {
+            .none => null,
+            .bearer => |key| key,
+        };
+        const value = token orelse break :blk .{ .public_only = .no_credential };
+        break :blk .{ .authenticated = .{
+            .source = .stored_key,
+            .credential = value,
+            .team_context = null,
+        } };
+    };
+    const fetched = model_catalog.fetchWithPublicFallback(provider, alloc, .{
+        .access = access,
+        .endpoint = cfg.models_path,
+        .view = .picker,
+    });
+    switch (fetched) {
+        .failed => |failure| {
+            debug_trace.logf("catalog", "provider switch catalog failed provider={s} category={s}", .{ bound.label(), @tagName(failure.failure.category) });
+            return null;
+        },
+        .loaded => |loaded| {
+            var catalog = loaded.catalog;
+            defer model_catalog.freeModelCatalog(alloc, &catalog);
+            if (catalog.items.len == 0) return null;
+            return try alloc.dupe(u8, catalog.items[0].id);
+        },
+    }
+}
