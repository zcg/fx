+
+    /// Clears the field being edited. A pasted key is long enough that deleting
+    /// it one byte at a time is not a way to replace it, so the whole field is
+    /// clearable at once. The key is zeroed rather than just truncated: it is a
+    /// secret, and a shorter length must not leave the bytes readable.
+    pub fn clearAddProviderField(self: *Self) bool {
+        const draft = if (self.add_provider_draft) |*value| value else return false;
+        switch (draft.field) {
+            .name => draft.name.clearRetainingCapacity(),
+            .base_url => draft.base_url.clearRetainingCapacity(),
+            .preset, .protocol => return false,
+            .api_key => {
+                std.crypto.secureZero(u8, @volatileCast(draft.key.items));
+                draft.key.clearRetainingCapacity();
+            },
+        }
+        return true;
+    }
+
+    /// Deletes the last typed byte of the current field.
+    pub fn deleteAddProviderByte(self: *Self) bool {
+        const draft = if (self.add_provider_draft) |*value| value else return false;
+        const target = switch (draft.field) {
+            .name => &draft.name,
+            .base_url => &draft.base_url,
+            .preset, .protocol => return false,
+            .api_key => &draft.key,
+        };
+        if (target.items.len == 0) return false;
+        const end = text_utils.utf8BackwardBoundary(target.items, target.items.len - 1);
+        target.shrinkRetainingCapacity(end);
+        return true;
+    }
+
+    /// The protocol names the add-provider flow offers, in picker order.
+    pub const add_provider_protocols = [_][]const u8{
+        "openai-chat-completions",
+        "anthropic-messages",
+        "openai-responses",
+    };
+
+    /// Moves the preset or protocol selection by one row, wrapping. Returns
+    /// false when the current field is typed rather than chosen.
+    /// Moves the selection inside the add-provider walk, or reports that the
+    /// walk owns the key. Every step owns the arrows, including the text fields
+    /// where there is no list to move in: while a provider is being set up the
+    /// arrows belong to this flow alone, and letting them fall through would
+    /// switch subagents mid-typing, which is how a keystroke meant for a field
+    /// changed the screen instead.
+    pub fn moveAddProviderSelection(self: *Self, delta: i32) bool {
+        const draft = if (self.add_provider_draft) |*value| value else return false;
+        // Every step owns the arrows, including the text fields where there is
+        // no list to move in. While a provider is being set up the arrows belong
+        // to this walk alone: letting them fall through switched subagents
+        // mid-typing, which is how a keystroke meant for a field changed the
+        // screen instead.
+        switch (draft.field) {
+            .name, .base_url, .api_key => return true,
+            .preset, .protocol => {},
+        }
+        const count = switch (draft.field) {
+            .preset => provider_presets.option_count,
+            .protocol => add_provider_protocols.len,
+            .name, .base_url, .api_key => unreachable,
+        };
+        if (count == 0) return false;
+        const current: usize = switch (draft.field) {
+            .preset => draft.preset_index orelse 0,
+            .protocol => for (add_provider_protocols, 0..) |name, index| {
+                if (std.mem.eql(u8, name, draft.protocol)) break index;
+            } else 0,
+            else => return false,
+        };
+        var next: usize = current;
+        if (delta < 0) {
+            next = if (next == 0) count - 1 else next - 1;
+        } else {
+            next = if (next + 1 == count) 0 else next + 1;
+        }
+        switch (draft.field) {
+            .preset => draft.preset_index = next,
+            .protocol => draft.protocol = add_provider_protocols[next],
+            else => return false,
+        }
+        return true;
+    }
+
+    /// Hands the typed key to the caller and clears it from the draft, so the
+    /// secret leaves the runtime exactly once. The caller zeroes it.
+    pub fn takeAddProviderKey(self: *Self, alloc: Allocator) ?[]u8 {
+        const draft = if (self.add_provider_draft) |*value| value else return null;
+        if (draft.key.items.len == 0) return null;
+        const owned = alloc.dupe(u8, draft.key.items) catch return null;
+        const allocated = draft.key.allocatedSlice();
+        secret.zeroAndFree(alloc, allocated);
+        draft.key = .empty;
+        return owned;
+    }
+
+    /// Advances to the next field. Returns the completed field when Enter
+    /// finished the last one, so the caller saves from the draft; null on a
+    /// normal step or when a required value is still empty.
+    pub fn advanceAddProvider(self: *Self, alloc: Allocator) ?AddProviderField {
+        const draft = if (self.add_provider_draft) |*value| value else return null;
+        switch (draft.field) {
+            .preset => {
+                // No preset chosen yet means the walk starts from a name, which
+                // is what the custom row asks for. Returning here instead is what
+                // left a fresh draft on the preset list forever.
+                const index = draft.preset_index orelse {
+                    draft.protocol = add_provider_protocols[0];
+                    draft.field = .name;
+                    return null;
+                };
+                if (provider_presets.presetAt(index)) |preset| {
+                    // A chosen preset pre-fills the rest of the walk: the name,
+                    // the URL, the protocol, and the key's environment slot.
+                    draft.name.clearRetainingCapacity();
+                    draft.name.appendSlice(alloc, preset.name) catch return null;
+                    draft.base_url.clearRetainingCapacity();
+                    draft.base_url.appendSlice(alloc, preset.base_url) catch return null;
+                    draft.protocol = preset.protocol.wireName();
+                    // Only the key is left to enter.
+                    draft.field = .api_key;
+                } else {
+                    // The custom row starts empty, including the key slot.
+                    draft.protocol = "";
+                    draft.field = .name;
+                }
+                return null;
+            },
+            .name, .base_url => {
+                const value = if (draft.field == .name) draft.name.items else draft.base_url.items;
+                if (value.len == 0) return null;
+            },
+            .protocol => {
+                if (draft.protocol.len == 0) return null;
+            },
+            // The caller validates an empty key before saving.
+            .api_key => {},
+        }
+        const next: ?AddProviderField = switch (draft.field) {
+            .preset => unreachable,
+            .name => .base_url,
+            .base_url => .protocol,
+            .protocol => .api_key,
+            .api_key => null,
+        };
+        if (next) |field| {
+            // Entering the protocol step with nothing chosen would leave the
+            // user on an empty list; the common protocol is the one to start
+            // on, and it is still changeable with the arrows.
+            if (field == .protocol and draft.protocol.len == 0) draft.protocol = add_provider_protocols[0];
+            draft.field = field;
+            return null;
+        }
+        return draft.field;
+    }
