+/// Saves one named connection under `providers`, creating the object when the
+/// settings have none. An existing connection of the same name is replaced
+/// whole: a half-edited definition is worse than a retyped one.
+fn putConfiguredProvider(
+    arena: Allocator,
+    root: *std.json.ObjectMap,
+    definition: ConfiguredProviderPatch,
+) !bool {
+    if (definition.name.len == 0 or definition.name.len > 64) return error.InvalidProviderName;
+    for (definition.name) |byte| {
+        if (!std.ascii.isAlphanumeric(byte) and byte != '-' and byte != '_') return error.InvalidProviderName;
+    }
+    if (definition.protocol.len == 0 or definition.base_url.len == 0) return error.InvalidProviderDefinition;
+    var changed = false;
+    const providers = if (root.getPtr("providers")) |value| blk: {
+        if (value.* != .object) return error.InvalidSettingsFormat;
+        break :blk &value.object;
+    } else blk: {
+        try root.put(arena, "providers", .{ .object = .empty });
+        changed = true;
+        break :blk &root.getPtr("providers").?.object;
+    };
+    const previous_name = definition.previous_name orelse definition.name;
+    const renamed = !std.mem.eql(u8, previous_name, definition.name);
+    if (renamed and providers.contains(definition.name)) return error.DuplicateProvider;
+    var body: std.json.ObjectMap = if (providers.get(previous_name)) |prior|
+        if (prior == .object) prior.object else return error.InvalidSettingsFormat
+    else
+        .empty;
+    try body.put(arena, "protocol", .{ .string = definition.protocol });
+    try body.put(arena, "base_url", .{ .string = definition.base_url });
+    var auth: std.json.ObjectMap = .empty;
+    try auth.put(arena, "type", .{ .string = "bearer" });
+    try auth.put(arena, "key", .{ .string = definition.key });
+    try body.put(arena, "auth", .{ .object = auth });
+    var candidate: std.json.ObjectMap = .empty;
+    try candidate.put(arena, definition.name, .{ .object = body });
+    var validated = try configured_provider.Registry.parse(arena, .{ .object = candidate });
+    validated.deinit(arena);
+    if (renamed) {
+        _ = providers.orderedRemove(previous_name);
+        if (root.getPtr("models")) |models| {
+            if (models.* == .object) if (models.object.fetchOrderedRemove(previous_name)) |prior| {
+                try models.object.put(arena, definition.name, prior.value);
+            };
+        }
+        if (root.getPtr("provider")) |provider| {
+            if (provider.* == .string and std.mem.eql(u8, provider.string, previous_name)) provider.string = definition.name;
+        }
+    }
+    const existing = providers.getPtr(definition.name);
+    if (existing) |prior| {
+        // Replacing whole: the object above is already complete.
+        prior.* = .{ .object = body };
+        return true;
+    }
+    // A newly added connection goes first, and the ones added before it shift
+    // down. The picker lists them in file order, so the connection a user just
+    // set up is the one they see at the top the next time they open it,
+    // instead of somewhere below every vendor they have ever tried.
+    var reordered: std.json.ObjectMap = .empty;
+    try reordered.put(arena, definition.name, .{ .object = body });
+    var prior_entries = providers.iterator();
+    while (prior_entries.next()) |entry| {
+        try reordered.put(arena, entry.key_ptr.*, entry.value_ptr.*);
+    }
+    providers.* = reordered;
+    return true;
+}
+
+/// Removes one named connection. The `providers` object itself is left in place
+/// even when it empties, so a settings file does not lose a section the user may
+/// add to again; the model saved for that connection is removed with it.
+///
+/// A `provider` that names the removed connection is cleared too. Leaving it
+/// behind points the profile at a connection that no longer exists, and the next
+/// start cannot resolve a provider at all.
+fn removeConfiguredProvider(root: *std.json.ObjectMap, name: []const u8) bool {
+    var changed = false;
+    if (root.getPtr("providers")) |value| {
+        if (value.* == .object) {
+            if (value.object.orderedRemove(name)) changed = true;
+        }
+    }
+    if (root.getPtr("models")) |value| {
+        if (value.* == .object) {
+            if (value.object.orderedRemove(name)) changed = true;
+        }
+    }
+    if (root.getPtr("provider")) |value| {
+        if (value.* == .string and std.mem.eql(u8, value.string, name)) {
+            _ = root.orderedRemove("provider");
+            changed = true;
+        }
+    }
+    return changed;
+}
